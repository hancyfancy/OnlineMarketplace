@{
    ViewData["Title"] = "Account";
    Layout = "~/Views/Layouts/AuthenticatedMaster.cshtml";
}

<h4 class="mb-4">Account</h4>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">

    <div class="col">
        <a asp-area="Identity" asp-controller="Account" asp-action="Profile"
           class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm account-card">
                <div class="card-body d-flex flex-column align-items-start p-4">
                    <i class="fa-solid fa-user text-primary mb-3" style="font-size:22px;"></i>
                    <h6 class="fw-semibold mb-1">Profile</h6>
                    <p class="text-muted small mb-0">Manage your personal details and preferences</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-area="Identity" asp-controller="Account" asp-action="Api"
           class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm account-card">
                <div class="card-body d-flex flex-column align-items-start p-4">
                    <i class="fa-solid fa-key text-secondary mb-3" style="font-size:22px;"></i>
                    <h6 class="fw-semibold mb-1">API Access</h6>
                    <p class="text-muted small mb-0">Manage your API key and authentication</p>
                </div>
            </div>
        </a>
    </div>

</div>