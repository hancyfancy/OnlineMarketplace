@model Web.Areas.Identity.Models.Api
@{
    ViewData["Title"] = "API Access";
    Layout = "~/Views/Layouts/AuthenticatedMaster.cshtml";
}

<nav aria-label="breadcrumb" class="breadcrumb-nav mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-area="Identity" asp-controller="Account" asp-action="Index">Account</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page"><span>API Access</span></li>
    </ol>
</nav>

<h2>API Access</h2>

<div class="row">
    <div class="col-md-8">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="card-title mb-1">API Key</h5>
                <p class="text-muted small mb-4">Your API key grants programmatic access to the platform. It is stored securely and cannot be retrieved once generated — copy it immediately after regenerating.</p>

                @if (TempData["NewApiKey"] != null)
                {
                    <div class="alert alert-success">
                        <strong>New API key — copy it now, it will not be shown again:</strong>
                        <code class="d-block mt-2 user-select-all fs-6">@TempData["NewApiKey"]</code>
                    </div>
                }

                @if (TempData["ApiKeyError"] != null)
                {
                    <div class="alert alert-danger">@TempData["ApiKeyError"]</div>
                }

                <form asp-area="Identity" asp-controller="Account" asp-action="RegenerateApiKey" method="post">
                    <button type="submit" class="btn btn-outline-secondary">Regenerate API Key</button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="card-title mb-1">Authentication</h5>
                <p class="text-muted small mb-3">Use your API key to obtain a short-lived JWT bearer token from the token endpoint. Include the token in all subsequent API requests.</p>
                <h6 class="text-muted small fw-semibold mb-1">Step 1 — Request a token</h6>
                <pre class="bg-light border rounded p-3 small mb-3"><code>POST /api/v1/token
Content-Type: application/json

{
  "email": "you@example.com",
  "apiKey": "&lt;your-api-key&gt;"
}</code></pre>
                <h6 class="text-muted small fw-semibold mb-1">Step 2 — Call the API</h6>
                <pre class="bg-light border rounded p-3 small mb-0"><code>GET /api/v1/resource
Authorization: Bearer &lt;access_token&gt;</code></pre>
            </div>
        </div>

    </div>
</div>