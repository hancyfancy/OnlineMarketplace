@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Layouts/AnonymousMaster.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3>Login</h3>
            </div>
            <div class="card-body">                
                <div class="d-grid gap-2">
                    <form asp-area="Identity" asp-controller="Anonymous" asp-action="Login" method="post">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
                        <button type="submit" class="btn btn-primary btn-lg">
                            Login with Google
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
