@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Portal";
    Layout = "~/Views/Layouts/AuthenticatedMaster.cshtml";
    var canSell = (await AuthorizationService.AuthorizeAsync(User, null, "ActiveSeller")).Succeeded;
}

<h4 class="mb-4">Portal</h4>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">

    <div class="col">
        <div class="card h-100 border-0 shadow-sm portal-card">
            <div class="card-body d-flex flex-column align-items-start p-4">
                <i class="fa-solid fa-cart-shopping text-success mb-3" style="font-size:22px;"></i>
                <h6 class="fw-semibold mb-1">Products</h6>
                <p class="text-muted small mb-3">Browse, list, and manage products</p>
                <div class="d-flex gap-2 mt-auto">
                    <a asp-area="Private" asp-controller="Product" asp-action="Search"
                       class="btn btn-outline-primary btn-sm">Search</a>
                    @if (canSell)
                    {
                        <a asp-area="Private" asp-controller="Product" asp-action="Add"
                           class="btn btn-primary btn-sm">Add</a>
                    }
                </div>
            </div>
        </div>
    </div>

</div>